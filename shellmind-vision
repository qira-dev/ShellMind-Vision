#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
ROOT_DIR="${SHELLMIND_VISION_ROOT:-${SCRIPT_DIR}}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ ! -d "${RUNTIME_DIR}" ]]; then
    RUNTIME_DIR="${ROOT_DIR}/data"
fi
PID_FILE="${RUNTIME_DIR}/shellmind-vision.pid"
LOCK_FILE="${RUNTIME_DIR}/shellmind-vision.lock"
LOG_FILE="${ROOT_DIR}/logs/server.log"
PORT="${SHELLMIND_VISION_PORT:-${DESKTOP_UI_MCP_PORT:-39200}}"
HOST="${SHELLMIND_VISION_HOST:-${DESKTOP_UI_MCP_HOST:-127.0.0.1}}"
TESSDATA_DIR="${ROOT_DIR}/native_ocr/root/usr/share/tesseract-ocr/5/tessdata"

export SHELLMIND_VISION_ROOT="${ROOT_DIR}"
export XDG_RUNTIME_DIR="${RUNTIME_DIR}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for wl in "${XDG_RUNTIME_DIR}"/wayland-*; do
        if [[ -S "${wl}" ]]; then
            export WAYLAND_DISPLAY="$(basename "${wl}")"
            break
        fi
    done
fi
export PATH="${ROOT_DIR}/runtime/node/bin:${ROOT_DIR}/bin:${HOME}/.local/bin:${PATH}"

mkdir -p "${ROOT_DIR}/data" "${ROOT_DIR}/logs" "${TESSDATA_DIR}" "${RUNTIME_DIR}"

is_running() {
    if [[ -f "${PID_FILE}" ]]; then
        local pid
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
            if tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q "server.mjs"; then
                return 0
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

wait_for_health() {
    local i
    for i in $(seq 1 50); do
        if curl -fsS --max-time 1 "http://${HOST}:${PORT}/health" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

cmd_up() {
    exec 9>"${LOCK_FILE}"
    if ! flock -n 9; then
        wait_for_health || true
        if is_running; then
            echo "[ShellMind Vision] Already running (PID $(cat "${PID_FILE}")) on http://${HOST}:${PORT}/mcp"
            return 0
        fi
    fi

    if is_running; then
        local live_root
        live_root="$(curl -fsS --max-time 1 "http://${HOST}:${PORT}/health" 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin).get("root",""))' 2>/dev/null || true)"
        if [[ -n "${live_root}" && "${live_root}" != "${ROOT_DIR}" ]]; then
            echo "[ShellMind Vision] Restarting daemon from ${live_root} -> ${ROOT_DIR}..."
            cmd_down
        else
            echo "[ShellMind Vision] Already running (PID $(cat "${PID_FILE}")) on http://${HOST}:${PORT}/mcp"
            return 0
        fi
    fi

    if [[ -n "${XDG_CURRENT_DESKTOP:-}" && "${XDG_CURRENT_DESKTOP,,}" == *gnome* ]]; then
        gsettings set org.gnome.desktop.interface toolkit-accessibility true 2>/dev/null || true
    fi
    setsid node "${ROOT_DIR}/server.mjs" >> "${LOG_FILE}" 2>&1 < /dev/null &
    local pid=$!
    disown "${pid}" 2>/dev/null || true
    echo "${pid}" > "${PID_FILE}"
    if wait_for_health; then
        echo "[ShellMind Vision] Started successfully (PID ${pid})"
        echo "  • Streamable HTTP MCP : http://${HOST}:${PORT}/mcp"
        echo "  • SSE MCP Endpoint    : http://${HOST}:${PORT}/sse"
        echo "  • Health Probe        : http://${HOST}:${PORT}/health"
        echo "  • Stdio Entrypoint    : node ${ROOT_DIR}/mcp-stdio.mjs"
    else
        echo "[ShellMind Vision] Failed to start. Check ${LOG_FILE}"
        rm -f "${PID_FILE}"
        exit 1
    fi
}

cmd_down() {
    if is_running; then
        local pid
        pid="$(cat "${PID_FILE}")"
        kill "${pid}" 2>/dev/null || true
        rm -f "${PID_FILE}"
        echo "[ShellMind Vision] Stopped (PID ${pid})"
    else
        rm -f "${PID_FILE}"
        echo "[ShellMind Vision] Not running"
    fi
}

cmd_status() {
    if is_running; then
        local pid
        pid="$(cat "${PID_FILE}")"
        echo "[ShellMind Vision] RUNNING (PID ${pid}) on port ${PORT}"
        ps -p "${pid}" -o pid,rss,pcpu,etime,cmd || true
    else
        echo "[ShellMind Vision] STOPPED"
    fi
}

cmd_doctor() {
    "${ROOT_DIR}/bin/computer-use-linux" doctor
}

cmd_lang() {
    local subcmd="${1:-list}"
    shift || true
    case "${subcmd}" in
        list)
            echo "[ShellMind Vision] Installed OCR Languages in ${TESSDATA_DIR}:"
            for f in "${TESSDATA_DIR}"/*.traineddata; do
                if [[ -f "${f}" ]]; then
                    local base
                    base="$(basename "${f}" .traineddata)"
                    local sz
                    sz="$(du -h "${f}" | cut -f1)"
                    echo "  • ${base} (${sz})"
                fi
            done
            ;;
        add)
            local lang="${1:-}"
            if [[ -z "${lang}" ]]; then
                echo "Usage: shellmind-vision lang add <language_code|all> (e.g. ben, jpn, fra, spa, hin, ara, deu, chi_sim)"
                exit 1
            fi
            echo "[ShellMind Vision] Fetching language '${lang}' on-demand from official fast quantized registry..."
            ROOT_DIR="${ROOT_DIR}" node -e '
              import(process.env.ROOT_DIR + "/lib/bridge.mjs").then(async (m) => {
                const b = new m.CulMcpBridge();
                const res = await b.callTool("ensure_language", { language: process.argv[1] });
                console.log(res.content[0].text);
              });
            ' "${lang}"
            ;;
        *)
            echo "Usage: shellmind-vision lang {list|add <lang_code|all>}"
            exit 1
            ;;
    esac
}

case "${1:-status}" in
    up|start)
        cmd_up
        ;;
    down|stop)
        cmd_down
        ;;
    restart)
        cmd_down
        sleep 1
        cmd_up
        ;;
    status)
        cmd_status
        ;;
    doctor)
        cmd_doctor
        ;;
    logs)
        tail -n 50 "${LOG_FILE}"
        ;;
    lang)
        shift
        cmd_lang "$@"
        ;;
    *)
        echo "Usage: shellmind-vision {up|down|restart|status|doctor|logs|lang}"
        exit 1
        ;;
esac
